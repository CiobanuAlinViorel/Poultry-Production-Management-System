<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         PARENT — the PPMS multi-module coordinator, not Spring Boot directly.
         This is what makes shared-kernel a proper module of the reactor
         build: groupId, version, dependencyManagement and plugin defaults
         all come from here instead of being duplicated.
         ===================================================================== -->
    <parent>
        <groupId>com.ppms</groupId>
        <artifactId>ppms-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shared-kernel</artifactId>
    <packaging>jar</packaging>

    <name>PPMS Shared Kernel</name>
    <description>
        Cross-cutting library shared by all four bounded-context services:
        User, Role, AuditLog, Alert, Notification. Contains no domain-specific
        business logic (see Section 3 of the Specs). Each service persists its
        own copy of these entities in its own schema — this module ships the
        JPA entity/behaviour definitions only, never a shared database.
    </description>

    <dependencies>

        <!-- JPA — User/Role/AuditLog/Alert/Notification are entities that
             each service persists into its own schema (NFR-M-02) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Email delivery for CRITICAL alerts (X2-FR-02) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- JWT — issuing/validating tokens against the shared secret (X1-FR-04) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- No <build><plugins> section: shared-kernel is a plain library, not an
         executable Spring Boot app, so the spring-boot-maven-plugin (repackage)
         must NOT be applied here. The compiler/annotation-processor config
         from ppms-parent's pluginManagement still applies automatically. -->

</project>
