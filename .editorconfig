root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,html,css,scss}]
indent_style = space
indent_size = 2

[*.{xml,sql}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.sh}]
indent_style = tab
