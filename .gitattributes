# Default — normalize all text files to LF
* text=auto eol=lf

# Force LF for shell scripts
*.sh text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat these as binary — never touch line endings
*.jar binary
*.war binary
*.png binary
*.jpg binary
*.pdf binary